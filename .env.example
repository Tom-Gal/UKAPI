APP_NAME=UKApi.co.uk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=dev
# Set APP_ENV=production, APP_DEBUG=false and an HTTPS APP_URL in beta/production.
# APP_PREVIOUS_KEYS=base64:... # only during a planned APP_KEY rotation

# Set this only when TLS is terminated by an ingress or load balancer you trust.
# TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Required in production. Use the approved legal/trading identity and postal
# address. Leave registration numbers blank only when they do not legally apply.
LEGAL_ENTITY_NAME=
LEGAL_COMPANY_NUMBER=
LEGAL_REGISTERED_OFFICE=
LEGAL_CONTACT_EMAIL=contact@ukapi.co.uk
LEGAL_PRIVACY_EMAIL=privacy@ukapi.co.uk
LEGAL_SECURITY_EMAIL=security@ukapi.co.uk
LEGAL_LEGAL_EMAIL=legal@ukapi.co.uk
LEGAL_ICO_NUMBER=
LEGAL_LAST_UPDATED="18 October 2026"

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production recommendation: LOG_STACK=stderr and LOG_LEVEL=info

# Laravel Cloud provisions MySQL credentials for connected database resources.
# For a local MySQL instance, set the values below; Cloud injects its own values.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ukapi
DB_USERNAME=ukapi
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# MYSQL_ATTR_SSL_CA=/absolute/path/to/ca.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Laravel Cloud plans without a persistent Worker cluster must use sync. This
# safely delivers notifications during the initiating request instead of
# accumulating database jobs with no consumer. Change to database only when a
# dedicated worker runs mail-critical,mail continuously.
QUEUE_CONNECTION=sync
# This only applies to the optional database-worker deployment. Its 120-second
# reservation is longer than the 45-second notification timeout.
DB_QUEUE_RETRY_AFTER=120
UKAPI_CRITICAL_MAIL_QUEUE=mail-critical
UKAPI_DEFAULT_MAIL_QUEUE=mail
UKAPI_LOGIN_ALERT_DEDUPLICATION_DAYS=30

CACHE_STORE=redis
# Give each deployment its own prefix when Valkey is shared.
# CACHE_PREFIX=ukapi-beta-cache-

MEMCACHED_HOST=127.0.0.1

# Laravel Cloud injects REDIS_HOST and REDIS_PASSWORD when a Redis resource is
# attached. These local defaults are for development only.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
# REDIS_URL=
# REDIS_QUEUE_CONNECTION=default
# REDIS_QUEUE=default
# REDIS_QUEUE_RETRY_AFTER=90

# Postcodes.io is public and does not require an API key.
POSTCODES_IO_BASE_URL=https://api.postcodes.io
POSTCODES_IO_CONNECT_TIMEOUT=2
POSTCODES_IO_TIMEOUT=5
POSTCODES_IO_CACHE_TTL_DAYS=30
POSTCODES_IO_NEGATIVE_CACHE_TTL_MINUTES=15

# Police.uk is public and does not require an API key. UKAPI callers still
# authenticate with a UKAPI API key before this provider is contacted.
POLICE_UK_BASE_URL=https://data.police.uk/api
POLICE_UK_USER_AGENT="UKApi.co.uk/1.0"
POLICE_UK_CONNECT_TIMEOUT=2
POLICE_UK_TIMEOUT=5
POLICE_UK_CRIME_CACHE_TTL_HOURS=24
POLICE_UK_CATEGORIES_CACHE_TTL_HOURS=24
POLICE_UK_PROVIDER_REQUEST_LIMIT=120
POLICE_UK_PROVIDER_LIMIT_WINDOW_SECONDS=60

# Environment Agency flood-monitoring is public and England-only. Live warning
# data is cached briefly and is never served stale if the source is unavailable.
ENVIRONMENT_AGENCY_BASE_URL=https://environment.data.gov.uk/flood-monitoring
ENVIRONMENT_AGENCY_USER_AGENT="UKApi.co.uk/1.0"
ENVIRONMENT_AGENCY_CONNECT_TIMEOUT=2
ENVIRONMENT_AGENCY_TIMEOUT=5
ENVIRONMENT_AGENCY_CACHE_TTL_MINUTES=5
ENVIRONMENT_AGENCY_NEARBY_DISTANCE_KILOMETRES=10
ENVIRONMENT_AGENCY_MAX_RESULTS=100
ENVIRONMENT_AGENCY_MAX_READINGS=100
ENVIRONMENT_AGENCY_PROVIDER_REQUEST_LIMIT=120
ENVIRONMENT_AGENCY_PROVIDER_LIMIT_WINDOW_SECONDS=60

# Keep this only in local/deployment secret configuration. The key is the HTTP Basic username.
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_BASE_URL=https://api.company-information.service.gov.uk
COMPANIES_HOUSE_USER_AGENT="UKApi.co.uk/1.0"
COMPANIES_HOUSE_CONNECT_TIMEOUT=2
COMPANIES_HOUSE_TIMEOUT=5
COMPANIES_HOUSE_PROFILE_CACHE_TTL_MINUTES=15
COMPANIES_HOUSE_OFFICERS_CACHE_TTL_MINUTES=60
COMPANIES_HOUSE_FILINGS_CACHE_TTL_MINUTES=15
COMPANIES_HOUSE_SEARCH_CACHE_TTL_MINUTES=15
COMPANIES_HOUSE_STALE_CACHE_TTL_MINUTES=120
COMPANIES_HOUSE_NEGATIVE_CACHE_TTL_MINUTES=10
COMPANIES_HOUSE_PROVIDER_REQUEST_LIMIT=500
COMPANIES_HOUSE_PROVIDER_LIMIT_WINDOW_SECONDS=300

# DVSA MOT History API credentials. The application obtains and caches OAuth
# client-credential tokens automatically. Keep all credentials in the deployment
# secret store; a fixed access token is only an optional short-lived override.
MOT_HISTORY_BASE_URL=https://history.mot.api.gov.uk
MOT_HISTORY_CLIENT_ID=
MOT_HISTORY_CLIENT_SECRET=
MOT_HISTORY_SCOPE_URL=https://tapi.dvsa.gov.uk/.default
MOT_HISTORY_TOKEN_URL=https://login.microsoftonline.com/a455b827-244f-4c97-b5b4-ce5d13b4d00c/oauth2/v2.0/token
MOT_HISTORY_API_KEY=
# Optional short-lived override. Leave blank for automatic token acquisition.
MOT_HISTORY_ACCESS_TOKEN=
MOT_HISTORY_CONNECT_TIMEOUT=2
MOT_HISTORY_TIMEOUT=10
MOT_HISTORY_CACHE_TTL_MINUTES=15
MOT_HISTORY_NEGATIVE_CACHE_TTL_MINUTES=10
MOT_HISTORY_PROVIDER_REQUEST_LIMIT=10
MOT_HISTORY_PROVIDER_LIMIT_WINDOW_SECONDS=1

# SIC lookup/search uses a locally refreshed copy of Companies House's condensed SIC 2007 list.
SIC_REFERENCE_SOURCE_URL=https://resources.companieshouse.gov.uk/sic/
# Set this to a writable absolute path in production; the bundled snapshot is used until it exists.
# SIC_REFERENCE_SNAPSHOT_PATH=
SIC_REFERENCE_REFRESH_ENABLED=false

MAIL_MAILER=log
# Use SMTP in Laravel Cloud. `log` never delivers verification or reset emails.
MAIL_SCHEME=null
MAIL_URL=
MAIL_HOST=live.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=api
# Set this in the Cloud secret manager. Never commit a Mailtrap token.
MAIL_PASSWORD=
# Must be an address on a domain verified in Mailtrap.
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Send one usage notification per threshold each calendar month.
USAGE_NOTIFICATION_THRESHOLDS=80,100

# Scheduled sampled provider checks and operator alerts. Configure an external
# uptime monitor too: the application cannot alert if its scheduler is stopped.
HEALTH_MONITORING_ENABLED=true
HEALTH_MONITORING_WAIVED=false
HEALTH_STALE_AFTER_SECONDS=900
HEALTH_CONNECT_TIMEOUT_SECONDS=2
HEALTH_TIMEOUT_SECONDS=5
HEALTH_CRIME_SOURCE_MAX_AGE_DAYS=120
HEALTH_SIC_RETRIEVAL_MAX_AGE_DAYS=90
HEALTH_ALERTS_ENABLED=false
# Set true only when operator email alerts are intentionally handled elsewhere.
HEALTH_ALERTS_WAIVED=true
HEALTH_ALERT_EMAIL=
HEALTH_ALERT_FAILURE_THRESHOLD=2
HEALTH_ALERT_REPEAT_AFTER_MINUTES=360
HEALTH_ALERT_RECOVERY=true

# Bound invalid/revoked bearer-token attempts per client IP before an API key
# can be identified. Valid keys have their own plan-specific burst limits.
API_AUTH_FAILURE_LIMIT=30
API_AUTH_FAILURE_WINDOW_SECONDS=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Defaults to the same application locally. Point this at https://api.ukapi.co.uk
# in a deployed web build when the API is served from its own subdomain.
UKAPI_API_URL=https://api.ukapi.co.uk
VITE_API_BASE_URL="${UKAPI_API_URL}"
CORS_ALLOWED_ORIGINS="${APP_URL}"

# Current Laravel Cloud no-worker deployment. This is an intentional fallback
# until the plan includes a persistent Worker cluster. Do not set
# QUEUE_CONNECTION=database with these values, because queued jobs would have
# no consumer.
UKAPI_SCHEDULER_ENABLED=true
UKAPI_QUEUE_WORKER_ENABLED=false
UKAPI_QUEUE_MONITOR_ENABLED=false
UKAPI_QUEUE_MONITOR_WAIVED=true
UKAPI_QUEUE_MONITOR_MAX_PENDING=100
UKAPI_QUEUE_MONITOR_MAX_OLDEST_SECONDS=300
UKAPI_QUEUE_MONITOR_REPEAT_AFTER_MINUTES=60

# Stripe Billing (use secret-manager values in deployed environments).
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_HOBBY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_HOBBY_ANNUAL=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_SCALE_ANNUAL=
CASHIER_CURRENCY=gbp
CASHIER_CURRENCY_LOCALE=en_GB

# Optional only when PHP has no trusted CA store. Use an absolute local path.
# HTTP_CA_BUNDLE=
