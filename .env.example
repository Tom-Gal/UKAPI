APP_NAME=UKAPI.io
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=dev
# Set APP_ENV=production, APP_DEBUG=false and an HTTPS APP_URL in beta/production.
# APP_PREVIOUS_KEYS=base64:... # only during a planned APP_KEY rotation

# Set this only when TLS is terminated by an ingress or load balancer you trust.
# TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production recommendation: LOG_STACK=stderr and LOG_LEVEL=info

# PostgreSQL is the application database in local development and production.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ukapi
DB_USERNAME=ukapi
DB_PASSWORD=
DB_SCHEMA=public
# Set to require or verify-full for production when required by the host.
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# Give each deployment its own prefix when Valkey is shared.
# CACHE_PREFIX=ukapi-beta-cache-

MEMCACHED_HOST=127.0.0.1

# Laravel's redis driver is configured to talk to Valkey via Predis.
VALKEY_CLIENT=predis
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379
VALKEY_USERNAME=null
VALKEY_PASSWORD=null
VALKEY_DB=0
VALKEY_CACHE_DB=1
# VALKEY_URL=
# VALKEY_QUEUE_CONNECTION=default
# VALKEY_QUEUE=default
# VALKEY_QUEUE_RETRY_AFTER=90

# Postcodes.io is public and does not require an API key.
POSTCODES_IO_BASE_URL=https://api.postcodes.io

# Keep this only in local/deployment secret configuration. The key is the HTTP Basic username.
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_BASE_URL=https://api.company-information.service.gov.uk
COMPANIES_HOUSE_USER_AGENT="UKAPI.io/1.0"

# SIC lookup/search uses a locally refreshed copy of Companies House's condensed SIC 2007 list.
SIC_REFERENCE_SOURCE_URL=https://resources.companieshouse.gov.uk/sic/
# Set this to a writable absolute path in production; the bundled snapshot is used until it exists.
# SIC_REFERENCE_SNAPSHOT_PATH=

MAIL_MAILER=log
# Use smtp, resend, postmark or ses in production. `log` never delivers verification or reset emails.
MAIL_SCHEME=null
MAIL_URL=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Defaults to the same application locally. Point this at https://api.ukapi.io
# in a deployed web build when the API is served from its own subdomain.
VITE_API_BASE_URL="${APP_URL}"
CORS_ALLOWED_ORIGINS="${APP_URL}"

# Optional only when PHP has no trusted CA store. Use an absolute local path.
# HTTP_CA_BUNDLE=
