APP_NAME=UKAPI.io
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=dev
# Set APP_ENV=production, APP_DEBUG=false and an HTTPS APP_URL in beta/production.
# APP_PREVIOUS_KEYS=base64:... # only during a planned APP_KEY rotation

# Set this only when TLS is terminated by an ingress or load balancer you trust.
# TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production recommendation: LOG_STACK=stderr and LOG_LEVEL=info

# Laravel Cloud provisions MySQL credentials for connected database resources.
# For a local MySQL instance, set the values below; Cloud injects its own values.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ukapi
DB_USERNAME=ukapi
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# MYSQL_ATTR_SSL_CA=/absolute/path/to/ca.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Laravel Cloud can run a queue worker for the database connection. Change this
# to redis only after attaching Valkey and configuring a worker there.

CACHE_STORE=redis
# Give each deployment its own prefix when Valkey is shared.
# CACHE_PREFIX=ukapi-beta-cache-

MEMCACHED_HOST=127.0.0.1

# Laravel's redis driver is configured to talk to Valkey via Predis.
VALKEY_CLIENT=predis
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379
VALKEY_USERNAME=null
VALKEY_PASSWORD=null
VALKEY_DB=0
VALKEY_CACHE_DB=1
# VALKEY_URL=
# VALKEY_QUEUE_CONNECTION=default
# VALKEY_QUEUE=default
# VALKEY_QUEUE_RETRY_AFTER=90

# Postcodes.io is public and does not require an API key.
POSTCODES_IO_BASE_URL=https://api.postcodes.io

# Keep this only in local/deployment secret configuration. The key is the HTTP Basic username.
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_BASE_URL=https://api.company-information.service.gov.uk
COMPANIES_HOUSE_USER_AGENT="UKAPI.io/1.0"

# SIC lookup/search uses a locally refreshed copy of Companies House's condensed SIC 2007 list.
SIC_REFERENCE_SOURCE_URL=https://resources.companieshouse.gov.uk/sic/
# Set this to a writable absolute path in production; the bundled snapshot is used until it exists.
# SIC_REFERENCE_SNAPSHOT_PATH=

MAIL_MAILER=log
# Use SMTP in Laravel Cloud. `log` never delivers verification or reset emails.
MAIL_SCHEME=null
MAIL_URL=
MAIL_HOST=live.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=api
# Set this in the Cloud secret manager. Never commit a Mailtrap token.
MAIL_PASSWORD=
# Must be an address on a domain verified in Mailtrap.
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Send one usage notification per threshold each calendar month.
USAGE_NOTIFICATION_THRESHOLDS=80,100

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Defaults to the same application locally. Point this at https://api.ukapi.io
# in a deployed web build when the API is served from its own subdomain.
VITE_API_BASE_URL="${APP_URL}"
CORS_ALLOWED_ORIGINS="${APP_URL}"

# Stripe Billing (use secret-manager values in deployed environments).
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_HOBBY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=
CASHIER_CURRENCY=gbp
CASHIER_CURRENCY_LOCALE=en_GB

# Optional only when PHP has no trusted CA store. Use an absolute local path.
# HTTP_CA_BUNDLE=
